# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.
#
# This same .env is used in two different ways:
# - POSTGRES_USER/PASSWORD/DB are reused as-is by docker-compose.yml (compose
#   reads .env from this same directory automatically) to configure the
#   postgres container.
# - DATABASE_URL/REDIS_URL below use `localhost`, which is only correct when
#   running the app directly (uvicorn, outside Docker). Inside the Docker
#   Compose network, docker-compose.yml overrides both with the service names
#   (postgres, redis) instead of localhost — see README's Docker section.

# --- App ---
APP_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_DB=erp_produtos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://devuser:devpass@localhost:5432/erp_produtos

# --- Redis (used for caching, e.g. GET /produtos) ---
# No password on the local dev instance (redis-dev).
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
